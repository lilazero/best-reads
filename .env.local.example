# =================================================================
# MongoDB Configuration
# =================================================================
# change <user>:<password> to real credentials provided in Discord
MONGODB_URI=mongodb+srv://<user>:<password>@best-reads.rot0xta.mongodb.net/?appName=best-reads

# =================================================================
# Clerk Authentication
# =================================================================
# Get these from Clerk Dashboard (https://dashboard.clerk.com)
# 1. Create a new application in Clerk
# 2. Go to API Keys section
# 3. Copy the Publishable Key and Secret Key

# Clerk Publishable Key (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Clerk Secret Key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# =================================================================
# Clerk Webhook Configuration
# =================================================================
# Webhook Secret for verifying Clerk webhook requests
# To get this:
# 1. Go to Clerk Dashboard → Webhooks
# 2. Click "Add Endpoint"
# 3. Set URL to: https://your-domain.com/api/webhooks/clerk
# 4. Subscribe to events: user.created, user.updated, user.deleted
# 5. Copy the Signing Secret

CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =================================================================
# Clerk URLs (Optional - defaults work for most cases)
# =================================================================
# Uncomment and customize these if you want custom sign-in/up pages

# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
